{
  "schema": "note-filler.design-acceptance-claims/v1",
  "title": "設計驗收主張索引（機器可查）",
  "rule": "每一項主張必須同時具備：規格檔、實作錨點檔、測試錨點；禁止只靠敘述或彙總數字驗收。",
  "quality_gates_immutable": [
    "原稿逐字不可變",
    "無來源/【待補證】→pending_evidence",
    "只掛實際引用來源",
    "法條引用須通過離線查核"
  ],
  "claims": [
    {
      "id": "D-01",
      "title": "介面規格（路由／表單／匯出契約）",
      "spec_file": "docs/specs/note-filler-interface-contract.md",
      "manifest_ref": "docs/specs/evidence/note-filler-design-evidence-manifest.md",
      "gap_map_ref": "docs/design-evidence-gap-map-2026-07-19.md",
      "impl_anchors": [
        {
          "path": "app/server.py",
          "must_contain": [
            "@app.get(\"/\", response_class=HTMLResponse)",
            "@app.post(\"/run\", response_class=HTMLResponse)",
            "@app.get(\"/export\")",
            "last_doc",
            "run_pipeline"
          ]
        },
        {
          "path": "app/templates/index.html",
          "must_contain": [
            "action=\"/run\"",
            "enctype=\"multipart/form-data\"",
            "name=\"file\"",
            "accept=\".txt,.docx\""
          ]
        },
        {
          "path": "app/templates/result.html",
          "must_contain": [
            "class=\"cols\"",
            "id=\"original\"",
            "id=\"correction\"",
            "class=\"supplement\"",
            "class=\"pending\"",
            "details class=\"sources\"",
            "href=\"/export\""
          ]
        }
      ],
      "test_anchors": [
        "tests/test_server.py::test_index_returns_upload_form",
        "tests/test_server.py::test_run_renders_two_columns",
        "tests/test_server.py::test_export_returns_markdown_attachment",
        "tests/test_server.py::test_export_without_run_returns_404"
      ],
      "status_note": "文件型契約已落地；路由與模板可交叉驗證"
    },
    {
